#!/bin/bash

#---------------- Folder Arrangement ------------#
#                  |- train                      #
#         |- Data -|- test                       #
# ~/home -|- Packages                            #
#         |- Output -|- train                    #
#                    |- test                     #
#------------------------------------------------#


r#!/bin/bash

# Automatically locate repository root
root_path="$(cd "$(dirname "$0")/.." && pwd)"

data_root="$root_path/Data"
train_output_path="$root_path/Output/train"
test_output_path="$root_path/Output/test"

train_csv="$train_output_path/AAL_statistics_volumn_train.csv"
test_csv="$test_output_path/AAL_statistics_volumn_test.csv"

echo "=============== begin measurement ==============="

# Remove old CSV files so results are not appended twice
rm -f "$train_csv"
rm -f "$test_csv"


# =========================================================
# TRAINING SUBJECTS
# =========================================================
for input in "$data_root"/train/Data_*.nii
do
    subID="$(basename "$input")"
    filename="${subID%%.*}"

    echo "Processing training image $filename"

    subGMMask="$train_output_path/${filename}_greymatter_mask.nii.gz"
    atlas="$train_output_path/${filename}_aal.nii.gz"
    seedMask_path="$train_output_path/seedMasks"

    if [ ! -f "$subGMMask" ]; then
        echo "ERROR: Missing grey matter mask: $subGMMask"
        exit 1
    fi

    if [ ! -f "$atlas" ]; then
        echo "ERROR: Missing transformed AAL atlas: $atlas"
        exit 1
    fi

    # Ensure masks belong to the current subject
    rm -rf "$seedMask_path"

    echo ">>>> Creating ROI masks for $filename <<<<"

    source "$root_path/code/CreateSeedMask" \
        "$train_output_path/" \
        "${filename}_aal.nii.gz"

    # Start CSV row with subject ID
    printf "%s" "$filename" >> "$train_csv"

    # First 90 AAL ROIs
    for i in $(seq 1 90)
    do
        roiMask="$seedMask_path/${i}.nii.gz"

        if [ ! -f "$roiMask" ]; then
            echo
            echo "ERROR: Missing ROI mask $roiMask"
            exit 1
        fi

        # -V returns: voxel_count volume_mm3
        volume=$(fslstats "$subGMMask" \
            -k "$roiMask" \
            -V | awk '{print $2}')

        printf ",%s" "$volume" >> "$train_csv"
    done

    # Finish subject row
    printf "\n" >> "$train_csv"

    rm -rf "$seedMask_path"

    echo "Finished $filename"
done


# =========================================================
# TEST SUBJECTS
# =========================================================
for input in "$data_root"/test/Data_*.nii
do
    subID="$(basename "$input")"
    filename="${subID%%.*}"

    echo "Processing test image $filename"

    subGMMask="$test_output_path/${filename}_greymatter_mask.nii.gz"
    atlas="$test_output_path/${filename}_aal.nii.gz"
    seedMask_path="$test_output_path/seedMasks"

    if [ ! -f "$subGMMask" ]; then
        echo "ERROR: Missing grey matter mask: $subGMMask"
        exit 1
    fi

    if [ ! -f "$atlas" ]; then
        echo "ERROR: Missing transformed AAL atlas: $atlas"
        exit 1
    fi

    # Ensure masks belong to the current subject
    rm -rf "$seedMask_path"

    echo ">>>> Creating ROI masks for $filename <<<<"

    source "$root_path/code/CreateSeedMask" \
        "$test_output_path/" \
        "${filename}_aal.nii.gz"

    # Start CSV row with subject ID
    printf "%s" "$filename" >> "$test_csv"

    # First 90 AAL ROIs
    for i in $(seq 1 90)
    do
        roiMask="$seedMask_path/${i}.nii.gz"

        if [ ! -f "$roiMask" ]; then
            echo
            echo "ERROR: Missing ROI mask $roiMask"
            exit 1
        fi

        volume=$(fslstats "$subGMMask" \
            -k "$roiMask" \
            -V | awk '{print $2}')

        printf ",%s" "$volume" >> "$test_csv"
    done

    # Finish subject row
    printf "\n" >> "$test_csv"

    rm -rf "$seedMask_path"

    echo "Finished $filename"
done


echo "=============== measurement complete ==============="
echo "Training CSV: $train_csv"
echo "Test CSV:     $test_csv"