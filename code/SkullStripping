#!/bin/bash

# Automatically locate repository root
root_path="$(cd "$(dirname "$0")/.." && pwd)"

data_root="$root_path/Data/"
train_output_path="$root_path/Output/train/"
test_output_path="$root_path/Output/test/"

mkdir -p "$train_output_path" "$test_output_path"

echo "=============== begin skull stripping ==============="

# ---------- TRAINING IMAGES ----------
cd "${data_root}train/" || exit 1

for subID in Data_*.nii
do
    echo "Processing training image $subID"

    filename="${subID%%.*}"

    bet "$subID" \
        "${train_output_path}${filename}_brain.nii.gz"
done


# ---------- TEST IMAGES ----------
cd "${data_root}test/" || exit 1

for subID in Data_*.nii
do
    echo "Processing test image $subID"

    filename="${subID%%.*}"

    bet "$subID" \
        "${test_output_path}${filename}_brain.nii.gz"
done

echo "=============== skull stripping complete ==============="
