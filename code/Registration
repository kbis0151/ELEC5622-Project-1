#!/bin/bash

#---------------- Folder Arrangement ------------#
#                  |- train                      #
#         |- Data -|- test                       #
# ~/home -|- Packages                            #
#         |- Output -|- train                    #
#                    |- test                     #
#------------------------------------------------#

#!/bin/bash

# Automatically locate repository root
root_path="$(cd "$(dirname "$0")/.." && pwd)"

data_root="$root_path/Data"
package_DIR="$root_path/Packages"

train_output_path="$root_path/Output/train"
test_output_path="$root_path/Output/test"

floImg="$package_DIR/MNI152_T1_1mm_brain.nii.gz"
aalImg="$package_DIR/aal.nii.gz"

echo "=============== begin registration... ==============="

run_registration () {

    input="$1"
    output_dir="$2"

    subID="$(basename "$input")"
    filename="${subID%%.*}"

    echo "============================================"
    echo "Processing $filename"
    echo "============================================"

    refImg="$output_dir/${filename}_brain.nii.gz"

    affineImg="$output_dir/${filename}_MNI_affine.nii.gz"
    affineMat="$output_dir/${filename}_affine.txt"

    deformImg="$output_dir/${filename}_MNI_deform.nii.gz"
    cppImg="$output_dir/${filename}_cpp.nii.gz"

    transformedAAL="$output_dir/${filename}_aal.nii.gz"

    if [ ! -f "$refImg" ]; then
        echo "ERROR: Missing reference brain: $refImg"
        exit 1
    fi

    echo "Register MNI template using affine transform"

    reg_aladin \
        -ref "$refImg" \
        -flo "$floImg" \
        -res "$affineImg" \
        -aff "$affineMat"

    echo "Register MNI template using deformable transform"

    reg_f3d \
        -ref "$refImg" \
        -flo "$floImg" \
        -aff "$affineMat" \
        -res "$deformImg" \
        -cpp "$cppImg"

    echo "Transform AAL atlas"

    reg_resample \
        -ref "$refImg" \
        -flo "$aalImg" \
        -res "$transformedAAL" \
        -trans "$cppImg" \
        -inter 0

    echo "Finished $filename"
}


# ---------- TRAIN ----------
for input in "$data_root"/train/Data_*.nii
do
    run_registration "$input" "$train_output_path"
done


# ---------- TEST ----------
for input in "$data_root"/test/Data_*.nii
do
    run_registration "$input" "$test_output_path"
done


echo "=============== registration complete ==============="